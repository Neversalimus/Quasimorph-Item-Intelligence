  "Contracts": [
    {
      "Feature": "Loot modifiers",
      "Result": "Algorithm compatible; runtime perk validation retained",
      "Evidence": [
        "RollExpectedCount: floor(expected), plus one with probability fractional part.",
        "Corpse/storage modifiers use FLootCorpseItem / FLootStorageItem float perk parameters.",
        "Current implant modifier includes WoundEffectImplantDropChance effects and FImplantDropChance perks; amputation base and augment-station chance remain additive."
      ],
      "RuntimeCondition": "Data.Perks must expose paired Marauder 0.3/0.6/0.9/1.2, Organization 0.5 and Field Medic 0.25. DLL inspection does not validate runtime config values."
    },
    {
      "Feature": "Container save estimate",
      "Result": "Compatible neutral approximation; exclusions disclosed",
      "Evidence": [
        "GetDrop uses ManualDropId and station type. Base and extra pools are separate.",
        "Extra rolls use RollExpectedCount. Extra pool excludes TrashSubtype.QuestItem (2).",
        "Base drops depend on remaining points and prices. Both pools can be suppressed by mission item-despawn event filters.",
        "DungeonBuilder.SpawnDroppableContent passes current storage expectation and event filters at IL_0925."
      ],
      "Limitations": [
        "Neutral estimate excludes mission point budget, temporary Tech and location events.",
        "Unknown Tech/bonus eligibility and nonpositive or nonfinite eligible weights fail closed.",
        "Save Tech contexts required; no gameplay RNG consumed."
      ]
    },
    {
      "Feature": "Scavengers / Purge Brigade",
      "Result": "Four reward predicates and weighted candidate semantics compatible",
      "Evidence": [
        "Resources: Trash. Armor/weapons: Weapon/Helmet/Armor/Leggings/Boots. Food/meds: Consumable/FixationMedicine. Ammo/grenades: Ammo/Grenade.",
        "Whitelist uses Dictionary.Add from station and victim faction categories; duplicate categories are not merged.",
        "Base weight 1 plus matched whitelist weight 1 makes eligible records equiprobable. Multiple composites sharing one primary ID contribute K/N.",
        "Tech cap and faction tag are victim-dependent; IDs containing case-sensitive _custom excluded."
      ],
      "Limitations": [
        "Story and unsupported mission outcomes excluded.",
        "CEOElimination with Proxy Company excluded because faction capture mutates reward context."
      ]
    },
    {
